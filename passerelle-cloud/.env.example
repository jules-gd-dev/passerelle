# Passerelle Cloud gateway configuration.
# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Cloudflare Tunnel (used by the `tunnel` service) ---
# Create your tunnel with:  cloudflared tunnel create <name>
# then copy the generated JSON credentials file where TUNNEL_CREDENTIALS_PATH points.
TUNNEL_UUID=<your-tunnel-uuid>
TUNNEL_CREDENTIALS_PATH=/etc/cloudflared/<your-tunnel-uuid>.json
TUNNEL_HOSTNAME=<your-tunnel-hostname>

# --- Daemon handshake registry (C2) ---
# Where the gateway persists the machineId<->secret bindings. In the default
# docker-compose setup this lives in the `passerelle-data` volume; keep that
# volume across deploys so daemons are not re-challenged.
MACHINES_DB_PATH=/app/api/data/machines.json

# Comma-separated list of additional hostnames (besides *.trycloudflare.com)
# accepted as daemon tunnel URLs.
ALLOWED_TUNNEL_HOSTS=

# --- Session cookie encryption (H4) ---
# 32-byte key used to AES-256-GCM encrypt the __Host-passerelle_sessions cookie
# (which carries the daemons' session tokens). MUST be stable across restarts
# or all browser sessions are invalidated on each deploy.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_KEY=

# --- Version policy (exposed via GET /api/version-info) ---
# Daemons/PWA below min_required get a hard red warning (non-blocking).
# Daemons/PWA below min_recommended get a soft update hint.
# custom_startup_announcement is displayed to gateway users on startup.
# Format: X.X.X-tag (the tag is ignored by version comparisons).
VERSION_MIN_REQUIRED=0.0.0
VERSION_MIN_RECOMMENDED=0.0.0
VERSION_STARTUP_ANNOUNCEMENT=
